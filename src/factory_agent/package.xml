<?xml version="1.0"?>
<package format="3">
  <name>factory_agent</name>
  <version>0.3.0</version>
  <description>Constrained Chinese factory Agent with SOP retrieval and deterministic fallback.</description>
  <maintainer email="maintainer@example.com">Factory Robot Maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>factory_interfaces</depend>
  <exec_depend>python3-pydantic</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
