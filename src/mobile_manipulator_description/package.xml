<?xml version="1.0"?>
<package format="3">
  <name>mobile_manipulator_description</name>
  <version>0.2.0</version>
  <description>Tracked-look mobile manipulator with official UR5e and Robotiq descriptions.</description>
  <maintainer email="maintainer@example.com">Factory Robot Maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>robotiq_description</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
