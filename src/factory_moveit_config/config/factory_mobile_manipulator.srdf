<?xml version="1.0"?>
<robot name="factory_mobile_manipulator">
  <virtual_joint name="world_joint" type="planar" parent_frame="odom" child_link="base_footprint"/>

  <group name="arm">
    <chain base_link="arm_mount" tip_link="gripper_tcp"/>
  </group>
  <group name="gripper">
    <joint name="gripper_right_finger_joint"/>
  </group>
  <end_effector name="parallel_gripper" parent_link="gripper_tcp" group="gripper" parent_group="arm"/>
  <group_state name="open" group="gripper">
    <joint name="gripper_right_finger_joint" value="0.0"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="gripper_right_finger_joint" value="0.040"/>
  </group_state>

  <group_state name="stowed" group="arm">
    <joint name="arm_shoulder_pan_joint" value="0"/>
    <joint name="arm_shoulder_lift_joint" value="-1.57"/>
    <joint name="arm_elbow_joint" value="1.57"/>
    <joint name="arm_wrist_1_joint" value="-1.57"/>
    <joint name="arm_wrist_2_joint" value="-1.57"/>
    <joint name="arm_wrist_3_joint" value="0"/>
  </group_state>

  <!-- Adjacent links are excluded from self-collision checks. Workpieces,
       fingertip-to-workpiece contact and all environment collisions remain
       enabled. -->
  <disable_collisions link1="base_link" link2="arm_mount" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="left_front_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="left_rear_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="right_front_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="right_rear_wheel_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="left_track_visual" reason="Track cover"/>
  <disable_collisions link1="base_link" link2="right_track_visual" reason="Track cover"/>
  <disable_collisions link1="left_front_wheel_link" link2="left_track_visual" reason="Track cover"/>
  <disable_collisions link1="left_rear_wheel_link" link2="left_track_visual" reason="Track cover"/>
  <disable_collisions link1="right_front_wheel_link" link2="right_track_visual" reason="Track cover"/>
  <disable_collisions link1="right_rear_wheel_link" link2="right_track_visual" reason="Track cover"/>
  <disable_collisions link1="base_link" link2="sensor_mast" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="lidar_link" reason="Fixed sensor mount"/>
  <disable_collisions link1="sensor_mast" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="sensor_mast" link2="lidar_link" reason="Adjacent"/>
  <disable_collisions link1="sensor_mast" link2="tag_camera_link" reason="Adjacent"/>
  <disable_collisions link1="camera_link" link2="camera_optical_frame" reason="Adjacent"/>
  <disable_collisions link1="tag_camera_link" link2="tag_camera_optical_frame" reason="Adjacent"/>

  <disable_collisions link1="arm_mount" link2="arm_base_link" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link" link2="arm_base" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link" link2="arm_base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="arm_base_link_inertia" link2="arm_shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="arm_shoulder_link" link2="arm_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_upper_arm_link" link2="arm_forearm_link" reason="Adjacent"/>
  <disable_collisions link1="arm_forearm_link" link2="arm_wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="arm_wrist_1_link" link2="arm_wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="arm_wrist_2_link" link2="arm_wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="arm_wrist_3_link" link2="arm_flange" reason="Adjacent"/>
  <disable_collisions link1="arm_wrist_3_link" link2="arm_ft_frame" reason="Adjacent"/>
  <disable_collisions link1="arm_flange" link2="arm_tool0" reason="Adjacent"/>
  <disable_collisions link1="arm_wrist_3_link" link2="ur_to_robotiq_link" reason="Tool adapter"/>
  <disable_collisions link1="arm_tool0" link2="ur_to_robotiq_link" reason="Adjacent"/>
  <disable_collisions link1="ur_to_robotiq_link" link2="gripper_mount_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_mount_link" link2="gripper_parallel_base_link" reason="Adjacent"/>
  <disable_collisions link1="ur_to_robotiq_link" link2="gripper_parallel_base_link" reason="Fixed tool overlap"/>
  <disable_collisions link1="gripper_parallel_base_link" link2="gripper_left_finger_tip_link" reason="Actuated mechanism"/>
  <disable_collisions link1="gripper_parallel_base_link" link2="gripper_right_finger_tip_link" reason="Actuated mechanism"/>
  <disable_collisions link1="gripper_left_finger_tip_link" link2="gripper_right_finger_tip_link" reason="Parallel mechanism"/>
  <disable_collisions link1="gripper_parallel_base_link" link2="gripper_grasp_anchor" reason="Fixed frame"/>
</robot>
