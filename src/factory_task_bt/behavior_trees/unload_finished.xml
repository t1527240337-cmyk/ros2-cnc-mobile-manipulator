<root BTCPP_format="4" main_tree_to_execute="UnloadFinished">
  <BehaviorTree ID="UnloadFinished">
    <Fallback name="task_scope">
      <Sequence name="unload_finished_workflow">
        <BeginPhysicalTask task_id="{task_id}"/>
        <EnsureEnergy task_id="{task_id}" auto_recharge="{auto_recharge}"/>
        <WaitMachineDone task_id="{task_id}" machine_id="{machine_id}"
                         part_id="{part_id}"/>
        <DockStation task_id="{task_id}" station_id="{machine_id}"
                     result_timeout_sec="180"/>
        <PickPart task_id="{task_id}" station_id="{machine_id}"
                  part_id="{part_id}"
                  result_timeout_sec="180"/>
        <ConfirmMachineUnload task_id="{task_id}" machine_id="{machine_id}"
                              part_id="{part_id}"/>
        <UndockStation task_id="{task_id}" station_id="{machine_id}"/>
        <DockStation task_id="{task_id}" station_id="finished_bin"
                     result_timeout_sec="240"/>
        <PlacePart task_id="{task_id}" station_id="finished_bin"
                   part_id="{part_id}"
                   result_timeout_sec="180"/>
        <CommitPlaceFinished task_id="{task_id}" part_id="{part_id}"/>
        <UndockStation task_id="{task_id}" station_id="finished_bin"/>
        <CompletePhysicalTask task_id="{task_id}"/>
      </Sequence>
      <Sequence name="abort_failed_unload">
        <AbortPhysicalTask task_id="{task_id}"/>
        <AlwaysFailure/>
      </Sequence>
    </Fallback>
  </BehaviorTree>
</root>
