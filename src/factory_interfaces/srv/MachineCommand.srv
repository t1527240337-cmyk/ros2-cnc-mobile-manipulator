uint8 OPEN_DOOR=0
uint8 CLOSE_DOOR=1
uint8 START=2
uint8 RESET=3
uint8 INJECT_FAULT=4
uint8 HOLD=5
uint8 RESUME=6
# These commands acknowledge a robot operation that has already passed its
# physical truth checks. They update the simulated PLC register; they never
# move the robot or teleport a workpiece.
uint8 CONFIRM_LOAD=7
uint8 CONFIRM_UNLOAD=8

string machine_id
uint8 command
string part_id
---
bool accepted
uint16 error_code
string message
