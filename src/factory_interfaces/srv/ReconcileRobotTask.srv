# Resolve a task stopped after an unknown physical outcome. The caller must
# first reconcile robot pose, gripper, workpiece, inventory and PLC registers.
uint8 RETRY=0
uint8 MARK_SUCCEEDED=1
uint8 CANCEL=2

string task_id
uint8 resolution
bool physical_state_verified
string operator_note
---
bool accepted
factory_interfaces/RobotTaskState task
string message
