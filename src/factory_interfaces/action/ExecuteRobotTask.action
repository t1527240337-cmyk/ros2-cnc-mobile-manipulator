uint8 UNLOAD_FINISHED=0
uint8 LOAD_RAW=1

# One recoverable robot transaction. task_id identifies the transaction;
# part_id identifies the logical workpiece across load and unload tasks.
string task_id
uint8 task_kind
string machine_id
string part_id
# Geometry is deliberately absent: raw PICK and finished PLACE targets are
# selected from fresh perception inside the physical capability layer.
bool auto_recharge
---
bool success
bool retryable
uint16 error_code
string message
---
string phase
string machine_id
string detail
